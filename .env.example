DAYORDER_ENV=development
DAYORDER_ADDR=127.0.0.1:8080
DAYORDER_PUBLIC_URL=http://127.0.0.1:8080
DAYORDER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DAYORDER_AUTH_HMAC_KEY=replace-with-at-least-32-random-bytes

POSTGRES_DB=dayorder
POSTGRES_USER=dayorder_admin
POSTGRES_PASSWORD=dayorder-admin-development-only
POSTGRES_PORT=5432
DAYORDER_MIGRATOR_DB_PASSWORD=dayorder-migrator-development-only
DAYORDER_API_DB_PASSWORD=dayorder-api-development-only
DAYORDER_WORKER_DB_PASSWORD=dayorder-worker-development-only
MIGRATION_DATABASE_URL=postgres://dayorder_migrator:dayorder-migrator-development-only@127.0.0.1:5432/dayorder?sslmode=disable&search_path=dayorder
DATABASE_URL=postgres://dayorder_api:dayorder-api-development-only@127.0.0.1:5432/dayorder?sslmode=disable
WORKER_DATABASE_URL=postgres://dayorder_worker:dayorder-worker-development-only@127.0.0.1:5432/dayorder?sslmode=disable

DAYORDER_DB_MAX_CONNS=20
DAYORDER_DB_MIN_CONNS=2
DAYORDER_DB_MAX_CONN_LIFETIME=30m
DAYORDER_DB_MAX_CONN_IDLE_TIME=5m
DAYORDER_DB_STATEMENT_TIMEOUT=5s
DAYORDER_DB_LOCK_TIMEOUT=2s
DAYORDER_DB_IDLE_TX_TIMEOUT=10s
DAYORDER_DB_HEALTH_TIMEOUT=3s
