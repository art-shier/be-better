# Public configuration only. Secret values live in files under DAYORDER_SECRETS_DIR.
DAYORDER_DOMAIN=dayorder.example.invalid
DAYORDER_ACME_EMAIL=ops@example.invalid
DAYORDER_VERSION=0.3.0
DAYORDER_IMAGE_REVISION=git-commit-sha
DAYORDER_IMAGE_CREATED=2026-08-28T00:00:00Z
DAYORDER_SECRETS_DIR=./secrets

POSTGRES_DB=dayorder
POSTGRES_USER=dayorder_admin
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_admin_password
DAYORDER_MIGRATOR_DB_PASSWORD_FILE=/run/secrets/migrator_db_password
DAYORDER_API_DB_PASSWORD_FILE=/run/secrets/api_db_password
DAYORDER_WORKER_DB_PASSWORD_FILE=/run/secrets/worker_db_password
DAYORDER_BACKUP_DB_PASSWORD_FILE=/run/secrets/backup_db_password
DAYORDER_MONITOR_DB_PASSWORD_FILE=/run/secrets/monitor_db_password

DATABASE_URL_FILE=/run/secrets/api_database_url
WORKER_DATABASE_URL_FILE=/run/secrets/worker_database_url
MIGRATION_DATABASE_URL_FILE=/run/secrets/migration_database_url
DAYORDER_AUTH_HMAC_KEY_FILE=/run/secrets/auth_hmac_key
DAYORDER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
PGBACKREST_REPO1_CIPHER_PASS_FILE=/run/secrets/pgbackrest_cipher_pass

DAYORDER_SMTP_ADDRESS=smtp.example.invalid:587
DAYORDER_SMTP_FROM=DayOrder <noreply@example.invalid>
DAYORDER_SMTP_USERNAME=smtp-user
DAYORDER_SMTP_TLS_MODE=starttls

PROMETHEUS_PORT=9090
