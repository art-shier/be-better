root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{go,ts,tsx,js,mjs,json,css,html,sql,yaml,yml,toml}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.ps1]
indent_style = space
indent_size = 4
